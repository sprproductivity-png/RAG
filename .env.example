# Vector Database Configuration
# When using Docker container:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Fallback local embedded directory if Docker is offline (optional)
QDRANT_LOCAL_PATH=./data/qdrant_storage
QDRANT_PREFER_GRPC=false

# BM25 Storage Configuration
BM25_STORAGE_DIR=./data/bm25_indexes

# Embedding & Re-ranking Models
# Small, fast, high accuracy dense embeddings (384-dim)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# State-of-the-art cross-encoder for ms-marco / passage re-ranking
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Contextual Retrieval (Anthropic Situational Summary)
# Options: "heuristic" (zero-key offline extractive), "anthropic", "openai", "ollama"
CONTEXTUAL_RETRIEVAL_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Hybrid Search Defaults
DEFAULT_COLLECTION=documents
DEFAULT_DENSE_TOP_K=15
DEFAULT_SPARSE_TOP_K=15
DEFAULT_RERANK_TOP_K=5
DEFAULT_RRF_K=60
DEFAULT_DENSE_WEIGHT=0.5
DEFAULT_SPARSE_WEIGHT=0.5

# Server Configuration
HOST=0.0.0.0
PORT=8000

